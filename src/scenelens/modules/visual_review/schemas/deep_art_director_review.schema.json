{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GATalk Deep Art Director Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "executive_summary",
    "target_readback",
    "dimension_reviews",
    "findings",
    "preserve_items",
    "action_plan",
    "quality_gate_results",
    "confidence_notes"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "reviewer_id": {"const": "deep_art_director_review"},
    "executive_summary": {"type": "string", "minLength": 1},
    "target_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_stage",
        "target_style",
        "target_mood",
        "primary_focus",
        "protected_content",
        "review_exclusions"
      ],
      "properties": {
        "production_stage": {"type": "string"},
        "target_style": {"type": "string"},
        "target_mood": {"type": "string"},
        "primary_focus": {"type": "string"},
        "protected_content": {"type": "array", "items": {"type": "string"}},
        "review_exclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dimension_reviews": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "status",
          "intent_target",
          "reference_read",
          "current_read",
          "evidence_summary",
          "strengths",
          "risks",
          "linked_finding_ids",
          "confidence",
          "uncertainty"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "enum": [
              "composition",
              "visual_guidance",
              "focus_hierarchy",
              "colour_design",
              "value_structure",
              "lighting_atmosphere",
              "material_readability",
              "world_design_narrative"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "meets_target",
              "partially_meets",
              "deviates",
              "insufficient_evidence"
            ]
          },
          "intent_target": {"type": "string"},
          "reference_read": {"type": "string", "minLength": 1},
          "current_read": {"type": "string", "minLength": 1},
          "evidence_summary": {
            "type": "array",
            "maxItems": 6,
            "items": {"type": "string", "minLength": 1}
          },
          "strengths": {
            "type": "array",
            "maxItems": 3,
            "items": {"type": "string", "minLength": 1}
          },
          "risks": {
            "type": "array",
            "maxItems": 3,
            "items": {"type": "string", "minLength": 1}
          },
          "linked_finding_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "uncertainty": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "dimension_ids",
          "observation",
          "image_evidence",
          "measurement_evidence",
          "linked_image_role",
          "linked_region_ids",
          "evidence_claims",
          "impact",
          "recommended_action",
          "priority",
          "confidence",
          "counterevidence_or_uncertainty",
          "next_version_validation"
        ],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "dimension_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "composition",
                "visual_guidance",
                "focus_hierarchy",
                "colour_design",
                "value_structure",
                "lighting_atmosphere",
                "material_readability",
                "world_design_narrative"
              ]
            }
          },
          "observation": {"type": "string", "minLength": 1},
          "image_evidence": {"type": "string", "minLength": 1},
          "measurement_evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "linked_image_role": {
            "type": "string",
            "enum": ["reference", "current", "both"]
          },
          "linked_region_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_claims": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_id",
                "description",
                "current_rect",
                "reference_rect",
                "metric",
                "operator",
                "threshold",
                "tolerance",
                "confidence"
              ],
              "properties": {
                "claim_id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "current_rect": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                    "y": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                    "width": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                    "height": {"type": "number", "minimum": 0.0, "maximum": 1.0}
                  }
                },
                "reference_rect": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                    "y": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                    "width": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                    "height": {"type": "number", "minimum": 0.0, "maximum": 1.0}
                  }
                },
                "metric": {
                  "type": "string",
                  "enum": [
                    "mean_luminance",
                    "local_contrast",
                    "highlight_ratio",
                    "shadow_ratio",
                    "warmth_oklab_b",
                    "reference_luminance_delta"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [">=", "<=", "abs>="]
                },
                "threshold": {"type": "number"},
                "tolerance": {"type": "number", "minimum": 0.0},
                "confidence": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              }
            }
          },
          "impact": {"type": "string", "minLength": 1},
          "recommended_action": {"type": "string", "minLength": 1},
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "counterevidence_or_uncertainty": {"type": "string"},
          "next_version_validation": {"type": "string", "minLength": 1}
        }
      }
    },
    "preserve_items": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "action_plan": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "finding_ids",
          "action",
          "why_now",
          "dependencies",
          "ue5_steps",
          "risk",
          "verification"
        ],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "finding_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "action": {"type": "string", "minLength": 1},
          "why_now": {"type": "string", "minLength": 1},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "ue5_steps": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "risk": {"type": "string"},
          "verification": {"type": "string", "minLength": 1}
        }
      }
    },
    "quality_gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "reason"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["pass", "needs_attention", "insufficient_evidence"]
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence_notes": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
