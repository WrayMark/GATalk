{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneLens Asset Prompt Workshop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "prompt_title",
    "target_tool",
    "analysis_summary",
    "prompt_zh",
    "prompt_en",
    "negative_prompt",
    "constraints",
    "asset_groups",
    "change_summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reviewer_id": {"const": "asset_prompt_workshop"},
    "prompt_title": {"type": "string", "minLength": 1, "maxLength": 120},
    "target_tool": {"type": "string", "minLength": 1, "maxLength": 80},
    "analysis_summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "prompt_zh": {"type": "string", "minLength": 1, "maxLength": 12000},
    "prompt_en": {"type": "string", "minLength": 1, "maxLength": 12000},
    "negative_prompt": {"type": "string", "maxLength": 4000},
    "constraints": {
      "type": "array",
      "maxItems": 24,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "asset_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "visible_evidence",
          "uncertainty",
          "prompt_fragment_zh",
          "prompt_fragment_en"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "category": {"type": "string", "minLength": 1, "maxLength": 80},
          "visible_evidence": {"type": "string", "maxLength": 400},
          "uncertainty": {"type": "string", "maxLength": 400},
          "prompt_fragment_zh": {"type": "string", "minLength": 1, "maxLength": 800},
          "prompt_fragment_en": {"type": "string", "minLength": 1, "maxLength": 800}
        }
      }
    },
    "change_summary": {"type": "string", "maxLength": 800}
  }
}
