{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneLens Asset Breakdown",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "scene_understanding",
    "production_strategy",
    "assets",
    "relationships",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reviewer_id": {"const": "asset_breakdown_review"},
    "scene_understanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_type", "summary", "spatial_layers", "breakdown_rule"],
      "properties": {
        "scene_type": {"type": "string"},
        "summary": {"type": "string"},
        "spatial_layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string"}
        },
        "breakdown_rule": {"type": "string"}
      }
    },
    "production_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_assets", "modular_kits", "repeatable_assets", "materials_and_decals", "background_only"],
      "properties": {
        "hero_assets": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
        "modular_kits": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
        "repeatable_assets": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
        "materials_and_decals": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
        "background_only": {"type": "array", "maxItems": 12, "items": {"type": "string"}}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "name",
          "category",
          "semantic_type",
          "parent_asset_id",
          "level",
          "normalized_rect",
          "evidence_kind",
          "visible_evidence",
          "inferred_details",
          "uncertainty",
          "confidence",
          "occlusion_status",
          "reuse_group",
          "instance_count",
          "production_priority",
          "production_strategy",
          "module_pieces",
          "variants",
          "material_notes"
        ],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "building",
              "modular_piece",
              "prop",
              "vegetation",
              "terrain",
              "material",
              "decal",
              "background",
              "lighting_vfx",
              "character_vehicle",
              "unknown"
            ]
          },
          "semantic_type": {"type": "string"},
          "parent_asset_id": {"type": "string"},
          "level": {"type": "integer", "minimum": 0, "maximum": 5},
          "normalized_rect": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "evidence_kind": {"enum": ["visible_evidence", "ai_inference"]},
          "visible_evidence": {"type": "string"},
          "inferred_details": {"type": "string"},
          "uncertainty": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "occlusion_status": {"enum": ["none", "partial", "heavy", "uncertain"]},
          "reuse_group": {"type": "string"},
          "instance_count": {"type": "integer", "minimum": 1, "maximum": 999},
          "production_priority": {"enum": ["critical", "high", "medium", "low"]},
          "production_strategy": {"type": "string"},
          "module_pieces": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
          "variants": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
          "material_notes": {"type": "string"}
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_asset_id", "target_asset_id", "relation", "evidence"],
        "properties": {
          "source_asset_id": {"type": "string"},
          "target_asset_id": {"type": "string"},
          "relation": {"enum": ["parent_child", "repeated_variant", "assembled_with", "shares_material", "spatial_group", "possible_same_asset"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string"}
    }
  }
}

